{
  "name": "gym-api-backend",
  "version": "1.0.0",
  "description": "Gym Review API backend with Express, MongoDB, and Auth0",
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "db:push": "prisma db push",
    "test": "vitest run",
    "start": "node dist/server.js",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
